# Used by the automated tests (local Docker database). Contains no real secrets.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://busyness_app:app_dev_password@localhost:5433/busyness_test
DATABASE_MIGRATION_URL=postgres://busyness_owner:owner_dev_password@localhost:5433/busyness_test
APP_DB_ROLE=busyness_app
ENCRYPTION_KEY=dGVzdC1rZXktdGVzdC1rZXktdGVzdC1rZXktMzJieXQ=
MAIL_TRANSPORT=console
MAIL_FROM="Busyness Test <test@example.com>"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/test-files
HIBP_ENABLED=false
CLIENT_IP_HEADER=x-forwarded-for
