# Copy to .env.local for local development. Never commit real secrets.
# In production, set these in Netlify: Site configuration > Environment variables.

# Public URL of the app (no trailing slash). Used for links in emails and CSRF checks.
APP_URL=http://localhost:3000

# Database connection used by the running app. This role can NOT change or delete audit log rows.
# Neon: use the *pooled* connection string for the app role.
DATABASE_URL=postgres://busyness_app:app_dev_password@localhost:5433/busyness

# Owner connection, used only by migrations and admin scripts. Never give this to the running app.
# Netlify: set with scope "Builds" only.
DATABASE_MIGRATION_URL=postgres://busyness_owner:owner_dev_password@localhost:5433/busyness
APP_DB_ROLE=busyness_app

# 32 random bytes, base64. Encrypts two-factor secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Google login (optional; the button is hidden when empty).
# Redirect URI to register in Google Cloud Console: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Local: Mailpit from docker-compose (http://localhost:8025). Production: Brevo SMTP.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Busyness <no-reply@example.com>"

# File storage. Local: disk. Production: s3 (Cloudflare R2, EU jurisdiction bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/files
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Sessions
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Header with the real client IP. Netlify sets x-nf-client-connection-ip.
CLIENT_IP_HEADER=x-nf-client-connection-ip

# Check new passwords against the HaveIBeenPwned leak list (k-anonymity, password never leaves the server)
HIBP_ENABLED=true

DB_POOL_MAX=5
